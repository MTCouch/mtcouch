<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTCouch</title>
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/configuracoes.css">
    <link rel="stylesheet" href="/static/css/MTC_Form.css">
    <link rel="stylesheet" href="/static/css/calculadora.css">

</head>
<body>


    <%- include('../home/menu') %>


    <div class="container">
        <div class="main" style="margin-top: 10vh;">

            <div class="nome"></div>
                <div class="formulario">
                        <h1>Calculadora de Macronutrientes</h1>
    
                        <label for="peso">Peso (kg):
                            <input class="text" type="number" id="peso" placeholder="50kg" required>
                        </label>
                        
                        <label for="altura">Altura (cm):
                            <input class="text" type="number" id="altura" placeholder="160cm" required>
                        </label>
                        
                        <label for="idade">Idade (anos):
                            <input class="text" type="number" id="idade" placeholder="15 Anos" required>
                        </label>
                        
                        <label for="sexo">Sexo:
                            <select id="sexo">
                                <option value="masculino">Masculino</option>
                                <option value="feminino">Feminino</option>
                            </select>
                        </label>

                        <label for="atividade">Nível de Atividade Física:
                            <select id="atividade">
                                <option value="sedentario">Sedentário</option>
                                <option value="leve">Atividade leve (1-3 dias por semana)</option>
                                <option value="moderado">Atividade moderada (3-5 dias por semana)</option>
                                <option value="intenso">Atividade intensa (6-7 dias por semana)</option>
                            </select>
                        </label>
                         
                        <div class="centralizador">
                            <button class="submit" onclick="calcularMacronutrientes()">Calcular</button>
                        </div>

                        <div class="result" id="result"></div>

                    </div>
                </div>
        </div>
    </div>

    <script>
        function calcularMacronutrientes() {
            const peso = parseFloat(document.getElementById('peso').value);
            const altura = parseFloat(document.getElementById('altura').value);
            const idade = parseFloat(document.getElementById('idade').value);
            const sexo = document.getElementById('sexo').value;
            const atividade = document.getElementById('atividade').value;

            // Cálculo do BMR usando Mifflin-St Jeor
            let bmr;
            if (sexo === "masculino") {
                bmr = 10 * peso + 6.25 * altura - 5 * idade + 5;
            } else {
                bmr = 10 * peso + 6.25 * altura - 5 * idade - 161;
            }

            // Multiplicador de atividade
            let atividadeFactor;
            switch (atividade) {
                case "sedentario": atividadeFactor = 1.2; break;
                case "leve": atividadeFactor = 1.375; break;
                case "moderado": atividadeFactor = 1.55; break;
                case "intenso": atividadeFactor = 1.725; break;
            }

            // TDEE (gasto total diário)
            const tdee = bmr * atividadeFactor;

            // MACROS
            const proteinas = peso * 2; // 2g por kg
            const gordura = peso * 0.8; // 0.8g por kg
            const caloriasProteina = proteinas * 4;
            const caloriasGordura = gordura * 9;

            const caloriasRestantes = tdee - (caloriasProteina + caloriasGordura);
            const carboidratos = caloriasRestantes / 4;

            // Exibir no HTML
            document.getElementById('result').innerHTML = `
                <div>
                    </br>
                    
                        <div><strong>TDEE (Total de Calorias por Dia):</strong> ${tdee.toFixed(2)} kcal</div>
                        <input type="hidden" name="tdee" value="${tdee.toFixed(2)}">

                        <hr>

                        <div><strong>Proteínas:</strong> ${proteinas.toFixed(2)} g</div>
                        <input type="hidden" name="proteinas" value="${proteinas.toFixed(2)}">

                        <div><strong>Carboidratos:</strong> ${carboidratos.toFixed(2)} g</div>
                        <input type="hidden" name="carboidratos" value="${carboidratos.toFixed(2)}">

                        <div><strong>Gorduras:</strong> ${gordura.toFixed(2)} g</div>
                        <input type="hidden" name="gorduras" value="${gordura.toFixed(2)}">

                </div>
            `;
        }
    </script>
</body>
</html>
