<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fichas</title>
    
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/configuracoes.css">
    <link rel="stylesheet" href="/static/css/fichas.css">

    <style>
        main {
            display: flex;
            border: 3px dashed var(--verde-secundario);
            width: 50%;
            height: 75vh;
            padding: 5px;
            border-radius: 20px;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
            margin-left: 25vw;
        }
        section {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
            height: 100%;
            width: 100%;
            background-color: brown;
        }

        .exercicios {
            margin: 5px;
            height: 100%;
            width: 70%; 
            background-color: brown;
        }
        .fds {
            display: flex;
            flex-direction: column;
            overflow-y: scroll;
            margin: 5px;
            width: 30%;
            height: 100%;
        }

    </style>
    
</head>
<body>
    <%- include('../home/menu') %>


    <% if (fichas && fichas.length > 0) { %>
    <main>

        <div class="fds">
        <% for (let i = 0; i < fichas.length; i++) { %>
        <section onclick="carregarExercicios('<%= fichas[i].id %>')">
            <div>
                <h2 id="nome_ficha"><%= fichas[i].nome %></h2>
                <p><%= fichas[i].descricao %></p>
            </div>
        </section>
        <% } %>
        </div>

        <div class="exercicios" id="exercicios">
            <div class="scroll">  
                <p>Selecione uma ficha para ver os exercícios</p>
            </div>
        </div>

    </main>

    <% } else { %>
    <main>
        <a href="criar">Crie agora sua primeira ficha! <i>Clique aqui</i></a>
    </main>
    <% } %>

    <script>

        async function carregarExercicios(fichaId){

            try{
                const response = await fetch (` /usuarios/fichas/${fichaId}/exercicios `);
                console.log(response);
                // const exercicios = await response.json();

                const exerciciosDiv = document.getElementById('exercicios');
                exerciciosDiv.innerHTML = '';

                if (exercicios.length === 0) {
                    container.innerHTML = "<p>Nenhum exercício encontrado</p>";
                    return;
                }


                exercicios.forEach(element => {
                    container.innerHTML += `
                        <div class="exercicio">
                            <iframe src="${element.video_url}"></iframe>
                            <div class="text">
                                <h2>${element.nome}</h2>
                                <p>${element.descricao}</p>
                            </div> 
                        </div>
                    `;
                });
            } catch (err){
                console.log('Erro ao carregar exercícios: ' + err.message);
            }
        }
    </script>

</body>
</html>