<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fichas</title>
    
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/configuracoes.css">
    <link rel="stylesheet" href="/static/css/fichas.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">


    <style>
        main {
            display: flex;
            border: 3px dashed var(--verde-secundario);
            width: 70vw;
            height: 75vh;
            padding: 5px;
            border-radius: 20px;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
            margin-top: 10vh;
            margin-left: 25vw;
        }
        section {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
            height: 100px;
            width: 100%;
            background-color: var(--verde-primario);
            border-bottom: 2px solid var(--verde-secundario);
            padding: 10px;
            border-radius: 10px;
        }

        .fds {
            overflow-y: auto;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            margin: 5px;
            width: 30%;
            height: auto;
        }
        .sla {
            display: flex;
            justify-content: space-between;
            width: 100%;
        }
        .fds::-webkit-scrollbar {
            margin: 5px;
            width: 8px; /* largura da barra */
        }

        .fds::-webkit-scrollbar-track {
            background: #0d0f0d;
            border-radius: 10px;
        }

        .fds::-webkit-scrollbar-thumb {
            background-color: var(--verde-secundario); /* cor da barra */
            border-radius: 10px;
            border: 2px solid #0d0f0d; /* "espacinho" pro efeito arredondado */
        }

        .fds::-webkit-scrollbar-thumb:hover {
            background-color: var(--verde-primario); /* muda ao passar o mouse */
        }
    </style>
    
</head>
<body>

    <%- include('../home/menu') %>

    <% if (fichas && fichas.length > 0) { %>
    <% var ficha_atual = typeof ficha_atual !== "undefined" ? ficha_atual : null; %>

    <main>

        <div class="fds" >
        <% for (let i = 0; i < fichas.length; i++) { %>
        <section>
            <div class="sla">
                <div>
                    <p id="nome_ficha"><a href="/fichas/<%= fichas[i].id%>"><%= fichas[i].nome %></a></p>
                    <p><%= fichas[i].descricao %></p>
                </div>
                <a class="btnSalvar" href="/delete/<%= fichas[i].id %>" onclick="return confirmarExcluir()">
                    <i style="font-size: 25px; margin-right: 10px;" class="bi bi-trash"></i>
                </a>
                
            </div>
        </section>
        <% } %> 
        </div>
    
        <div class="exercicios">
            <%- include('../usuarios/fichas-exercicios', { dias_ficha: dias_ficha,ficha_atual: ficha_atual,fichas: fichas}) %>

        </div>
        
    </main>

    <% } else { %>
    <main>
        <div>
            <a href="/criar">Crie agora sua primeira ficha! <i>Clique aqui</i></a>
        </div>
    </main>
    <% } %>

    <script>
        function confirmarExcluir(){
            return confirm("Tem certeza que deseja excluir?");
        }
    </script>

</body>
</html>
