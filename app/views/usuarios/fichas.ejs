<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fichas</title>
    
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/configuracoes.css">
    <link rel="stylesheet" href="/static/css/fichas.css">

    <style>
        main {
            display: flex;
            border: 3px dashed var(--verde-secundario);
            width: 50%;
            height: 75vh;
            padding: 5px;
            border-radius: 20px;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
            margin-left: 25vw;
        }
        section {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
            height: 100%;
            width: 100%;
            border-bottom: 2px solid black;
        }

        .exercicios {
            margin: 5px;
            height: 100%;
            width: 70%; 
            overflow-y: auto;
            padding: 10px;
        }

        .fds {
            display: flex;
            flex-direction: column;
            overflow-y: scroll;
            margin: 5px;
            width: 30%;
            height: 100%;
        }
    </style>
    
</head>
<body>
    <%- include('../home/menu') %>

 
    <% if (fichas && fichas.length > 0) { %>
    <main>

        <div class="fds">
        <% for (let i = 0; i < fichas.length; i++) { %>
        <section>
            <div>
                <h2 id="nome_ficha"><a href="/fichas/<%= fichas[i].id%>"><%= fichas[i].nome %></a></h2>
                <p><%=fichas[i].id%></p>
                <p><%= fichas[i].descricao %></p>
                <a href="/delete/<%= fichas[i].id %>" onclick="return confirmarExcluir()">EXCLUIR</a>
            </div>
        </section>
        <% } %>
        </div>

        <div class="exercicios">
            <%- include('../usuarios/fichas-exercicios', { dias_ficha: dias_ficha, ficha: fichas }) %>
        </div>

        
    </main>

    <% } else { %>
    <main>
        <a href="/criar">Crie agora sua primeira ficha! <i>Clique aqui</i></a>
    </main>
    <% } %>

    <script>
        function confirmarExcluir(){
            return confirm("Tem certeza que deseja excluir?");
        }
    </script>

</body>
</html>
