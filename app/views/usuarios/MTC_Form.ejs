<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTCouch</title>
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/MTC_Form.css">
    <link rel="stylesheet" href="/static/css/config_index.css">

<style>
        #loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            transition: opacity 0.3s ease;
        }

        .hidden {
            display: none !important;
            opacity: 0;
            pointer-events: none;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid var(--verde-secundario);
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>



<div class="parent">
    <div class="div1" ><a class="a" href="/"><img src="/static/src/logo.jpg" alt="logo"></a></div>
    <div class="div2" ><a class="a" href="/criar">Criar</a></div>
    <div class="div3" ><a class="a" href="/mtcf">MGCouch</a></div>
    <div class="div4" ><a class="a" href="/exercicios">Exercícios</a></div>
    <div class="div5" ><a class="a" href="/treino">Treino</a></div>
</div>

    <div class="container">
        <div class="main">

            <div id="loading-overlay" class="hidden">
                <div class="spinner"></div>
                <p style="color: var(--verde-secundario)"> Buscando o treino ideal...</p>
            </div>

            <div class="nome">MTC</div>
            <form id="form" action="/mtcf" method="post">
                <div class="formulario">
                    <p class="descricao">Fale um pouco sobre seu treino</p>

                    <div class="inputs">
                        <label for="nome">Digite o nome
                            <input type="text" name="nome" id="nome" required>
                        </label>
                        
                        <label for="dias">Vezes por semana
                            <select name="dias" id="dias" required>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                                <option value="6">6</option>
                                <option value="7">7</option>
                            </select>
                        </label>
                        
                        <label for="experiencia">Sua experiencia com treinos
                            <select name="experiencia" id="experiencia" required>
                                <option value="iniciante">Iniciante</option>
                                <option value="intermediario">Intermediário</option>
                                <option value="avancado">Avançado</option>
                            </select>
                        </label>

                        
                        <label for="objetivo">Objetivo principal
                            <select name="objetivo" id="objetivo" required>
                                <option value="hipertrofia">Hipertrofia</option>
                                <option value="definicao">Definição</option>
                                <option value="resistencia">Resistência</option>
                                <option value="emagrecimento">Emagrecimento</option>
                            </select>
                        </label>
                    </div>

                    <div class="button">
                        <input class="input_button" type="submit" value="Testar Agora">
                    </div>

                </div>
            </form>
        </div>

    </div>

    <script>
        document.getElementById('form').addEventListener('submit', function(event) {
            document.getElementById('loading-overlay').classList.remove('hidden');
        });
    </script>

</body>
</html>
