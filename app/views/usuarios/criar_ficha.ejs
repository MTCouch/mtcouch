<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar</title>
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/criar.css">
</head>
<body>
<div class="parent">
    <div class="div1" ><a class="a" href="/">LOGO</a></div>
    <div class="div2" ><a class="a" href="/criar">Criar</a></div>
    <div class="div3" ><a class="a" href="/mtcf">MGCouch</a></div>
    <div class="div4" ><a class="a" href="/exercicios">Exercícios</a></div>
    <div class="div5" ><a class="a" href="">Treino</a></div>
</div>

<div class="conteiner">
    <div class="formulario">
        <h1 class="criar">+ Criar Ficha</h1>
            <form action="get">

                <label for="nome_treino">Nome do ficha:
                    <input id="nome_treino" name="nome_treino" type="text">
                </label>

                <br>

                <label for="dias">Vezes por dia:    
                <select name="dias" id="dias" name="dias">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                </select>
                </label>

                <br>

                <label for="descricao">Descrição da Ficha:
                    <input id="descricao" name="descricao" type="text">
                </label>

                <br>

                <input type="button" value="Criar">

            </form>
    </div>
</div>

</body>
</html>
