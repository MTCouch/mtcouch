<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Treino</title>
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/configuracoes.css">
    <link rel="stylesheet" href="/static/css/criar.css">
</head>
<body>

    <%- include('../home/menu') %>
    

<div class="conteiner">
    <div class="formulario">
        <h1 class="criar">+ Criar Ficha</h1>
            <form action="/treino" method="post">

                <label for="nome_treino">Nome do ficha:
                    <input id="nome_treino" name="nome_treino" type="text">
                </label>

                <br>

                <label for="dias">Vezes por semana:    
                <select name="dias" id="dias" name="dias">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                </select>
                </label>

                <br>

                <label for="descricao">Descrição da Ficha:
                    <input id="descricao" name="descricao" type="text">
                </label>

                <br>

                <input type="submit" value="Criar">

            </form>
    </div>
</div>

</body>
</html>
