<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/configuracoes.css">
    <link rel="stylesheet" href="/static/css/config_forms.css">
    <link rel="stylesheet" href="/static/css/login.css">

</head>
<body>

    <div class="parent">
        <div class="div1" ><a class="a" href="/"><img src="/static/src/logo.jpg" alt="logo"></a></div>
    </div>

    <div class="content">
        <div class="text_login">
            <p>Conheça o</p>
            <p class="nome">MTC</p>
            <p class="p_text">O seu personal</p>
            <p class="p_text">particular</p>
        </div>
    
        <div class="form">    
            <form action="/login" method="POST">
                <div class="center">
                <div>
                    <input type="email" id="email" name="email" class="input" placeholder="Email" required/>
                </div>
                <div>
                    <input type="password" id="senha" name="senha" class="input" placeholder="Senha" required/>
                </div>
                <label for="senha" class="esqueceu_sua_senha">Não tem uma conta? <a href="/registro">Registrar</a></label>

                <input type="submit" value="Logar"/>
                </div>
            </form>
        </div>
    </div>

</body>
</html>