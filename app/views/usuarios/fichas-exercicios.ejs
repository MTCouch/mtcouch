<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=add" />

    <style></style>
</head>
<body>

    <div class="conteiner">
    <div class="formulario" style="margin-top: 10vh;">
        
        <% if (ficha_atual) { %>
            <h1 id="planilha_nome"><%= ficha_atual.nome %></h1>

            <div class="exercicios">
                <div class="scrool">
                    
                    <% dias_ficha.forEach(dia => { %>
                        <div class="ficha">
                            <h1 class="text_Nome_Ficha" id="ficha_nome"><%= dia.nome_dia %></h1>

                            <% dia.exercicios.forEach(exercicio => { %>
                                <div class="exercicio">
                                    
                                    <div class="dvd">
                                        <iframe id="exercicio_video" 
                                                src="<%= exercicio.video %>" 
                                                style="border:none;" 
                                                allow="fullscreen"
                                                allowfullscreen></iframe>

                                        <div class="text_Nome_Exercicio">
                                            <h1 id="exercicio_nome" class="nomeExercicio">
                                                <%= exercicio.nome %>
                                            </h1>

                                            <% if(exercicio.series){ %>
                                                <p id="exercicio_serie" class="seriesExercicios">
                                                    <strong>Séries:</strong> <%= exercicio.series %>
                                                </p>
                                            <% } %>

                                            <% if(exercicio.repeticoes){ %>
                                                <p id="exercicio_repet" class="repeticoesExercicios">
                                                    <strong>Repetições:</strong> <%= exercicio.repeticoes %>
                                                </p>
                                            <% } %>

                                            <% if(exercicio.descanso){ %>
                                                <p id="exercicio_descanso" class="descansoExercicios">
                                                    <strong>Descanso:</strong> <%= exercicio.descanso %>
                                                </p>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="text_Detalhes_Exercicio">
                                        <% if (exercicio.observacoes) { %>
                                            <p id="exercicio_observacao" class="observacoesExercicios">
                                                <strong>Observações:</strong> <%= exercicio.observacoes %>
                                            </p>
                                        <% } %>
                                    </div>

                                </div>
                            <% }) %>
                        </div>
                    <% }) %>

                </div>
            </div>

        <% } else { %>
            <h2>Nenhum treino encontrado.</h2>
        <% } %>

    </div>
</div>
    
</body>
</html>