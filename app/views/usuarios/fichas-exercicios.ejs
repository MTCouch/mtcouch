<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/exercicios_ficha.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=add" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <style>
        .inputs{
            background: none;
            border: none;
            font-size: 1.2rem;
            margin-bottom: 10px;
            width: 50px;

        }
        i{
            color: var(--verde-secundario);
        }
    </style>
</head>
<body>

    <div class="conteiner">
    <div class="formulario" style="margin-top: 10vh;">
        
        <% if (ficha_atual) { %>
            <h1 id="planilha_nome"><%= ficha_atual.nome %></h1>

            <div class="exercicios">
                
                    <% dias_ficha.forEach(dia => { %>
                        <div class="ficha">
                            <h1 class="text_Nome_Ficha" id="ficha_nome"><%= dia.nome %><p><%= dia.descricao %></p></h1>
                            

                            <% dia.exercicios.forEach(exercicio => { %>
                                <div class="exercicio">
                                    
                                    <div class="dvd">
                                        <iframe id="exercicio_video" 
                                                src="<%= exercicio.video %>" 
                                                style="border:none;" 
                                                allow="fullscreen"
                                                allowfullscreen></iframe>

                                        <div class="text_Nome_Exercicio">
                                            <h1 id="exercicio_nome" class="nomeExercicio">
                                                <%= exercicio.nome %>
                                            </h1>

                                            <form action="/exercicio/<%= exercicio.id %>/salvar" method="POST" class="text_Nome_Exercicio">

                                                <div class="text_caracteristicas">
                                                    <label><strong>Séries:</strong></label>
                                                    <input class="inputs" type="number" name="series" value="<%= exercicio.series %>" placeholder="..." min="1" style="margin-bottom: 0;" required>

                                                    <label><strong>Repetições:</strong></label>
                                                    <input class="inputs" type="number" name="repeticoes" value="<%= exercicio.repeticoes %>" placeholder="..." min="1" style="margin-bottom: 0;" required>

                                                    <label><strong>Descanso:</strong></label>
                                                    <input class="inputs" type="number" name="descanso" value="<%= exercicio.descanso %>" placeholder="..." style="margin-bottom: 0;" required>

                                                    <button type="submit" class="btnSalvar">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>

                                                    <a class="btnSalvar" href="/delete_exercicio/<%= exercicio.id %>" onclick="return confirmarExcluir()">
                                                        <i class="bi bi-trash"></i>
                                                    </a>

                                                </div>

                                                <div class="text_obs">
                                                    <label><strong>Observações:</strong></label>
                                                    <textarea class="inputs" name="observacoes" rows="1" cols="500" placeholder="Observações" style="width: 100%;"><%= exercicio.observacoes %></textarea>
                                                </div>
                                            </form>

                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <div class="dvd">
                            <a href="/ad-exercicios/<%= dia.id %>">[<span class="material-symbols-outlined">add</span>] Adicionar!</a>
                        </div>

                    <% }) %>
            </div>

        <% } else { %>
            <h2>Selecione uma Ficha.</h2>
        <% } %>

    </div>
</div>
    
</body>
</html>