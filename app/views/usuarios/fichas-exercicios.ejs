<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=add" />

    <style></style>
</head>
<body>

    <% if (dias_ficha && dias_ficha.length > 0) { %>

        <h1><%  %></h1>
        <% dias_ficha.forEach(function(dia) { %>
            <div class="dia">
                <h2><%= dia.nome %></h2>
                <span class="material-symbols-outlined">add</span>
            </div>
        <% }); %>

    <% } else { %>
        <p></p>
    <% } %>


    
</body>
</html>