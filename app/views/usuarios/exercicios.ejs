<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTCouch</title>
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/exercicios.css">
    <link rel="stylesheet" href="/static/css/configuracoes.css">
</head>
<body>

    <%- include('../home/menu') %>


<div class="conteiner">
    <div class="formulario">
        <form action="">
            
            <input type="text" id="pesquisa" name="pesquisa" value="" placeholder="Pesquisar...">

            <select name="Agrupamento" id="">
                <option value="Peito">Peito</option>
                <option value="Costas">Costas</option>
                <option value="Bracos">Braços</option> 
                <option value="Ombros">Ombros</option>
                <option value="Antebracos">Antebraços</option>
                <option value="Quadriceps">Quadríceps</option>
                <option value="Posterior">Posterior</option>
                <option value="Gluteos">Glúteos</option>
                <option value="Panturrilhas">Panturrilhas</option>
                <option value="Adutores">Adutores</option>
                <option value="Abdutores">Abdutores</option>
                <option value="Abdomen">Abdômen</option>
            </select>

        </form>

        <div class="exercicios">
            <div class="scrool">
                <%for(let i=0; i < 101; i++){ %>
                    <div class="exercicio">
                        <iframe id="img" src="<%= exercicios[i].video%> || 0"></iframe>
                        <div class="text">
                            <h2 id="nome"><%= exercicios[i].nome%></h2>
                            <p id="descricao"><%= exercicios[i].agrupamento_muscular%></p>
                        </div> 
                        <input type="submit" value="Adicionar">
                    </div>
                <% } %>
            </div> 
        </div>

    </div>
</div>

</div>
    <script src="/static/script/exercicios.js"></script>
</body>
</html>