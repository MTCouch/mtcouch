<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTCouch</title>
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/exercicios.css">
    <link rel="stylesheet" href="/static/css/configuracoes.css">

    <style>
        .exercicio{
            display: flex;
            justify-content: flex-start;
            gap: 1rem;
            background: var(--verde-primario);
            border-radius: 10px;
            padding: 10px;
            margin-bottom: 10px;
            height: 200px;
            width: 100%;
            min-width: 460px;
        }
    </style>
</head>
<body>

    <%- include('../home/menu') %>


<div class="conteiner">
    <div class="formulario" style="margin-top: 10vh;">
        <form action="">
            
            <input type="text" id="pesquisa" name="pesquisa" value="" placeholder="Pesquisar...">

            <select name="Agrupamento" id="filtroGrupo">
                <option value="">Todos</option>
                <option value="Peito">Peito</option>
                <option value="Costas">Costas</option>
                <option value="Braços">Braços</option> 
                <option value="Ombros">Ombros</option>
                <option value="Pernas">Quadríceps</option>
                <option value="Pernas">Posterior</option>
                <option value="Gluteos">Glúteos</option>
                <option value="Panturrilha">Panturrilha</option>
                <option value="Abdômen">Abdômen</option>
                <option value="Full Body">Full Body</option>
            </select>

        </form>

        <div class="exercicios">
            <div class="scrool">
                <%for(let i=0; i < 101; i++){ %>
                    <form action="/salvar-exercicio/<%= diaId %> %>" method="POST">

                        <input type="hidden" name="nome" value="<%= exercicios[i].nome %>">
                        <input type="hidden" name="agrupamento_muscular" value="<%= exercicios[i].agrupamento_muscular %>">
                        <input type="hidden" name="exercicioId" value="<%= exercicios[i].id %>">
                        <input type="hidden" name="dificuldade" value="<%= exercicios[i].dificuldade %>">
                        <input type="hidden" name="classificacao" value="<%= exercicios[i].classificacao %>">
                        <input type="hidden" name="localidade" value="<%= exercicios[i].localidade %>">
                        <input type="hidden" name="video" value="<%= exercicios[i].video %>">
  

                        <div class="exercicio" data-grupo="<%= exercicios[i].agrupamento_muscular %>">
                            <iframe name="video" id="img" src="<%= exercicios[i].video%> || 0" style="border:none;" allow=" fullscreen" allowfullscreen></iframe>
                            
                            <div class="text">
                                <h2><%= exercicios[i].nome%></h2>
                                <p><%= exercicios[i].agrupamento_muscular%></p>
                            </div>

                            <% if(diaId){ %>
                                <div>
                                    <input type="submit" value="Adicionar">
                                </div>
                            <% }else{ %> 
                                <div hidden>
                                    <input hidden type="submit" value="Adicionar">
                                </div>
                            <% } %>
                        </div>
                    </form>
                <% } %>
            </div> 
        </div>

    </div>
</div>

</div>
<script>
    document.getElementById("pesquisa").addEventListener("input", filtrar);
    document.getElementById("filtroGrupo").addEventListener("change", filtrar);

    function filtrar() {
        const texto = document.getElementById("pesquisa").value.toLowerCase();
        const grupo = document.getElementById("filtroGrupo").value.toLowerCase();

        const lista = document.querySelectorAll(".exercicio");

        lista.forEach(ex => {
            const nome = ex.querySelector("h2").textContent.toLowerCase();
            const grupoEx = ex.dataset.grupo.toLowerCase();

            const matchNome = nome.includes(texto);
            const matchGrupo = grupo === "" || grupoEx === grupo;

            ex.style.display = matchNome && matchGrupo ? "flex" : "none";
        });
    }
</script>

</body>
</html>