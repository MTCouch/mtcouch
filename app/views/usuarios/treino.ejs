<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTCouch</title>
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/exercicios.css">
    <link rel="stylesheet" href="/static/css/config_index.css">
</head>
<body>

<div class="parent">
    <div class="div1" ><a class="a" href="/">LOGO</a></div>
    <div class="div2" ><a class="a" href="/criar">Criar</a></div>
    <div class="div3" ><a class="a" href="/mtcf">MGCouch</a></div>
    <div class="div4" ><a class="a" href="/exercicios">Exercícios</a></div>
    <div class="div5" ><a class="a" href="/treino">Treino</a></div>
</div>

<div class="conteiner">
    <div class="formulario">
        <% if(treino){ %>
        <h1><%= treino.nome %></h1>
        
        <% treino.fichas.forEach(ficha => { %>
            <div class="ficha">
                <h2><%= ficha.nome %></h2>
                <div class="exercicios">
                    <div class="scrool">
                        <% ficha.exercicios.forEach(exercicio => { %>
                            <div class="exercicio">
                                <iframe id="img" src="<%= exercicio.video %>"></iframe>

                                <h3 id="nome" class="nomeExercicio"><%= exercicio.nome %></h3>
                                <div class="text">
                                    <p class="seriesExercicios"><strong>Séries:</strong> <%= exercicio.series %></p>
                                    <p class="repeticoesExercicios"><strong>Repetições:</strong> <%= exercicio.repeticoes %></p>
                                    <p class="descansoExercicios"><strong>Descanso:</strong> <%= exercicio.descanso %></p>
                                    <% if (exercicio.observacoes) { %>
                                        <p class="observacoesExercicios"><strong>Observações:</strong> <%= exercicio.observacoes %></p>
                                    <% } %>
                                </div> 
                            </div>
                        <% }); %>
                    </div> 
                </div>
            </div>
        <% }); %>
        <% } else { %>
            <h2>Nenhum treino encontrado.</h2>
        <% } %>
    </div>
</div>

</div>
</body>
</html>