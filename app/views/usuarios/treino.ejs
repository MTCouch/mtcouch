<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MTCouch - Treino</title>
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/var.css">
    <link rel="stylesheet" href="/static/css/exercicios.css">
    <link rel="stylesheet" href="/static/css/config_index.css">
</head>
<body>

<div class="parent">
    <div class="div1"><a class="a" href="/">LOGO</a></div>
    <div class="div2"><a class="a" href="/criar">Criar</a></div>
    <div class="div3"><a class="a" href="/mtcf">MGCouch</a></div>
    <div class="div4"><a class="a" href="/exercicios">Exercícios</a></div>
    <div class="div5"><a class="a" href="/treino">Treino</a></div>
</div>

<div class="conteiner">
    <div class="formulario">
        <div class="exercicios">
            <% if (treino) { %>
                <h1 class="titulo">Treino de <%= treino.objetivo %> — <%= treino.frequencia %> dias/semana</h1>
                <h3 class="subtitulo">Nível: <%= treino.nivel %></h3>

                <% treino.dias.forEach((dia, indexDia) => { %>
                    <div class="dia">
                        <h2 class="nome-dia"><%= dia.nome %></h2>

                        <% if (dia.exercicios && dia.exercicios.length > 0) { %>
                            <% dia.exercicios.forEach((ex) => { %>
                                <div class="exercicio">
                                    <% if (ex.video) { %>
                                        <iframe class="video" src="<%= ex.video %>" allowfullscreen></iframe>
                                    <% } %>
                                    <div class="text">
                                        <h3><%= ex.nome %></h3>
                                        <p><strong>Séries:</strong> <%= ex.series %> — <strong>Repetições:</strong> <%= ex.repeticoes %></p>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p>Nenhum exercício listado para este dia.</p>
                        <% } %>
                    </div>
                <% }); %>

            <% } else { %>
                <p>Nenhum treino encontrado.</p>
            <% } %>
        </div>
    </div>
</div>
</body>
</html>
